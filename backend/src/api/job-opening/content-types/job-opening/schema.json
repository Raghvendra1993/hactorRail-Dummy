{
  "kind": "collectionType",
  "collectionName": "job_openings",
  "info": {
    "singularName": "job-opening",
    "pluralName": "job-openings",
    "displayName": "Job Opening",
    "description": "Open job positions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string"
    },
    "employmentType": {
      "type": "enumeration",
      "enum": ["Full-time", "Part-time", "Contract"],
      "default": "Full-time"
    },
    "description": {
      "type": "text"
    },
    "applyUrl": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
